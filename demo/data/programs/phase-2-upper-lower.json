        },
        {
          "exercise": "Seated Cable Row",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Lateral Raise",
          "sets": 3,
          "reps": "12-15"
        },
        {
          "exercise": "Face Pull",
          "sets": 2,
          "reps": "12-15"
        },
        {
          "exercise": "Incline Dumbbell Curl",
          "sets": 2,
          "reps": "10-12"
        }
      ]

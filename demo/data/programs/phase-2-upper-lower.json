        {
          "exercise": "Lat Pulldown",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Biceps Curl",
          "sets": 2,
          "reps": "10-12"
        },
        {
          "exercise": "Triceps Pushdown",
          "sets": 2,
          "reps": "10-12"
        }

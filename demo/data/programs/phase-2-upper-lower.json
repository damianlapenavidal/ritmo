    "Sat": {
      "name": "Soccer or tempo run (optional)",
      "type": "conditioning",
      "optional": true,
      "blocks": [
        {
          "exercise": "Tempo run",
          "sets": 1,
          "reps": "25-35 min conversational pace"
        }
      ]

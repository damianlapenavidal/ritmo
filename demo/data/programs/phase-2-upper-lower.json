    "Thu": {
      "name": "Upper B",
      "type": "lift",
      "blocks": [
        {
          "exercise": "Incline Dumbbell Press",
          "sets": 4,
          "reps": "8-10"
        },
        {
          "exercise": "Pull-up",
          "sets": 4,
          "reps": "6-8",

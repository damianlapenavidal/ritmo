  "week_template": {
    "Mon": {
      "name": "Gym A - Strength + power",
      "type": "lift",
      "blocks": [
        {
          "exercise": "Pogo Hops",
          "sets": 3,
          "reps": "15",
          "note": "quick, stiff ankles"
        },
        {
          "exercise": "Box Jump",
          "sets": 3,
          "reps": "4",
          "note": "low box, step down"
        },
        {
          "exercise": "Trap Bar Deadlift",
          "sets": 3,
          "reps": "5"
        },
        {
          "exercise": "Dumbbell Bench Press",
          "sets": 3,
          "reps": "8-10"
        },
        {
          "exercise": "Split Squat",
          "sets": 3,
          "reps": "8/side"
        },
        {
          "exercise": "Chest-Supported Row",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Nordic Hamstring Curl",
          "sets": 2,
          "reps": "3-5",
          "note": "band-assisted at first"
        },
        {
          "exercise": "Copenhagen Plank",
          "sets": 2,
          "reps": "15-20s/side",
          "note": "short-lever version first"
        }
      ]
    },
    "Tue": {
      "name": "Conditioning - Intervals",
      "type": "conditioning",
      "blocks": [
        {
          "exercise": "Intervals",
          "sets": 6,
          "reps": "1 min hard / 1 min easy",
          "note": "add 1 rep per week up to 10; track or bike"
        },
        {
          "exercise": "Agility",
          "sets": 4,
          "reps": "5-10-5 shuttle at ~80%",
          "note": "focus on decelerating well"
        }
      ]
    },
    "Wed": {
      "name": "Rest or easy walk + mobility",
      "type": "rest",
      "blocks": []
    },
    "Thu": {
      "name": "Gym B - Strength + elasticity",
      "type": "lift",
      "blocks": [
        {
          "exercise": "Lateral Bound",
          "sets": 3,
          "reps": "4/side",
          "note": "stick each landing"
        },
        {
          "exercise": "Med Ball Rotational Throw",
          "sets": 3,
          "reps": "5/side"
        },
        {
          "exercise": "Goblet Squat",
          "sets": 3,
          "reps": "8",
          "note": "move to Back Squat in week 3"
        },
        {
          "exercise": "Assisted Pull-up",
          "sets": 3,
          "reps": "6-8"
        },
        {
          "exercise": "Romanian Deadlift",
          "sets": 3,
          "reps": "8"
        },
        {
          "exercise": "Dumbbell Shoulder Press",
          "sets": 3,
          "reps": "8-10"
        },
        {
          "exercise": "Standing Calf Raise",
          "sets": 3,
          "reps": "12-15"
        },
        {
          "exercise": "Side Plank",
          "sets": 2,
          "reps": "30s/side"
        }
      ]
    },
    "Fri": {
      "name": "Conditioning - Tempo run or pickup soccer",
      "type": "conditioning",
      "blocks": [
        {
          "exercise": "Tempo run",
          "sets": 1,
          "reps": "20-30 min conversational pace",
          "note": "or 45-60 min of pickup soccer from week 3"
        }
      ]
    },
    "Sat": {
      "name": "Gym C - Speed + hypertrophy (from week 3)",
      "type": "lift",
      "optional": true,
      "blocks": [
        {
          "exercise": "Sprint accelerations",
          "sets": 6,
          "reps": "20 m at ~85%",
          "note": "full walk-back recovery"
        },
        {
          "exercise": "Leg Press",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Incline Dumbbell Press",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Lat Pulldown",
          "sets": 3,
          "reps": "10-12"
        },
        {
          "exercise": "Hip Thrust",
          "sets": 3,
          "reps": "10"
        },
        {
          "exercise": "Farmer Carry",
          "sets": 3,
          "reps": "30 m"
        }
      ]
    },
    "Sun": {
      "name": "Rest",
      "type": "rest",
      "blocks": []
    }
  },
  "benchmarks": [
    {
      "test": "1.5 mile run",

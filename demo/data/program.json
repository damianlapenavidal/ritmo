    "3": 7,
    "4": 7.5,
    "5": 8,
    "6": 6
  },
  "deload_weeks": [
    6
  ],
  "progression": "Double progression: work up to the top of the rep range at or below the week's RPE, then add step_lb. Miss the bottom of the range twice in a row: drop about 10%.",
